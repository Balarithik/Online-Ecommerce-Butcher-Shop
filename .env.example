# Required in production. Generate a long random value; never commit the real file.
SECRET_KEY=
DEBUG=True
# Comma-separated hostnames, without protocol.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated HTTPS origins allowed to POST (include every public site URL).
CSRF_TRUSTED_ORIGINS=https://lakshmi-broliers.onrender.com,http://localhost:8000,http://127.0.0.1:8000
# Set to False only for an explicitly non-HTTPS development deployment.
SECURE_SSL_REDIRECT=True
# WhatsApp number in international digits-only format (country code first).
WHATSAPP_NUMBER=919943708688
# Customer order notifications (actual providers used by orders/notifications.py).
# Resend: verify your sending domain before using a custom sender in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lakshmi Broilers <orders@your-verified-domain.com>
NOTIFICATION_SITE_URL=https://lakshmi-broliers.onrender.com

# Meta WhatsApp Cloud API. WhatsApp is sent only when the customer opts in at checkout.
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_TEMPLATE=order_update
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v22.0
ORDER_NOTIFICATION_COUNTRY_CODE=91

# MSG91 transactional SMS. Requires an approved Indian DLT template mapped in MSG91.
MSG91_AUTH_KEY=
MSG91_SMS_TEMPLATE_ID=

# Set either CLOUDINARY_URL or all three individual values for signed admin uploads.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional one-time initial admin creation at container startup; existing users are never changed.
# Remove these after the first successful bootstrap.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
