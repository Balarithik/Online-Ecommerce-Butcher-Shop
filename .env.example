# Required in production. Generate a long random value; never commit the real file.
SECRET_KEY=
DEBUG=True
# Comma-separated hostnames, without protocol.
ALLOWED_HOSTS=localhost,127.0.0.1
# Set to False only for an explicitly non-HTTPS development deployment.
SECURE_SSL_REDIRECT=True
# Optional: required only when using Cloudinary for uploaded product images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
