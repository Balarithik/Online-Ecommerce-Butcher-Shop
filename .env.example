# Required in production. Generate a long random value; never commit the real file.
SECRET_KEY=
DEBUG=True
# Comma-separated hostnames, without protocol.
ALLOWED_HOSTS=localhost,127.0.0.1
# Set to False only for an explicitly non-HTTPS development deployment.
SECURE_SSL_REDIRECT=True
# WhatsApp number in international digits-only format (country code first).
WHATSAPP_NUMBER=919943708688
# Optional order-confirmation notifications through Twilio. Leave blank to disable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Recommended for production WhatsApp; use an approved Twilio Content Template SID.
TWILIO_WHATSAPP_CONTENT_SID=
ORDER_NOTIFICATION_COUNTRY_CODE=91
# Required for signed admin product-image uploads to Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
